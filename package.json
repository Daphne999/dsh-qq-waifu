{
  "name": "dsh-qq-waifu",
  "version": "0.1.0",
  "description": "Waifu-mode replies for DSH on QQ: split one reply into several short chat bubbles with a human-like typing pace, plus configurable chunking. | 把 OPERIT 的 Waifu 模式搬到 QQ：一条回复切成几句、按打字速度逐条发送。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "Daphne999",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Daphne999/dsh-qq-waifu.git"
  },
  "bugs": {
    "url": "https://github.com/Daphne999/dsh-qq-waifu/issues"
  },
  "homepage": "https://github.com/Daphne999/dsh-qq-waifu#readme",
  "keywords": [
    "dsh-plugin",
    "qq",
    "chat",
    "waifu",
    "typing"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  }
}
